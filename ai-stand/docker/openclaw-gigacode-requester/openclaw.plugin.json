{
  "id": "ai-stand-gigacode-requester",
  "name": "ai-stand personal GigaCode requester",
  "description": "Binds a verified OpenClaw requester to a personal GigaCode subscription.",
  "categories": [
    "models",
    "security"
  ],
  "providers": [
    "gigacode"
  ],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["sessionMapPath", "telegramSubjectMapPath"],
    "properties": {
      "sessionMapPath": { "type": "string", "minLength": 1, "maxLength": 512 },
      "telegramSubjectMapPath": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  }
}

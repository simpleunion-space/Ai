{
  "schema_version": 1,
  "task_file": "task.md",
  "execution": {
    "max_parallel": 1,
    "command_timeout_seconds": 600
  },
  "clis": [
    { "id": "opencode", "display_name": "OpenCode", "enabled": true },
    { "id": "crush", "display_name": "Crush", "enabled": true },
    { "id": "kilo", "display_name": "Kilo CLI", "enabled": true }
  ],
  "providers": [
    {
      "id": "openrouter",
      "display_name": "OpenRouter",
      "type": "openrouter",
      "enabled": true,
      "api_key_env": "OPENROUTER_API_KEY",
      "models": [
        { "id": "qwen/qwen3-coder-plus", "target_id": "qwen-qwen3-coder-plus" },
        { "id": "deepseek/deepseek-v4-pro-0813", "target_id": "deepseek-deepseek-v4-pro-0813" },
        { "id": "z-ai/glm-5.3", "target_id": "zai-glm-5-3" },
        { "id": "moonshotai/kimi-k3", "target_id": "kimi-kimi-k3" },
        { "id": "openai/gpt-5.6-sol", "target_id": "openai-gpt-5-6-sol" },
        { "id": "anthropic/claude-sonnet-4.6", "target_id": "anthropic-claude-sonnet-4-6" }
      ]
    },
    {
      "id": "openai-compatible",
      "display_name": "OpenAI Compatible",
      "type": "openai-compatible",
      "enabled": false,
      "base_url_env": "OPENAI_COMPATIBLE_BASE_URL",
      "api_key_env": "OPENAI_COMPATIBLE_API_KEY",
      "models": []
    },
    {
      "id": "anthropic-compatible",
      "display_name": "Anthropic Compatible",
      "type": "anthropic-compatible",
      "enabled": false,
      "base_url_env": "ANTHROPIC_COMPATIBLE_BASE_URL",
      "api_key_env": "ANTHROPIC_COMPATIBLE_API_KEY",
      "models": []
    }
  ],
  "runs": [
    { "cli": "opencode", "provider": "openrouter", "model": "qwen/qwen3-coder-plus" },
    { "cli": "opencode", "provider": "openrouter", "model": "deepseek/deepseek-v4-pro-0813" },
    { "cli": "opencode", "provider": "openrouter", "model": "z-ai/glm-5.3" },
    { "cli": "opencode", "provider": "openrouter", "model": "moonshotai/kimi-k3" },
    { "cli": "opencode", "provider": "openrouter", "model": "openai/gpt-5.6-sol" },
    { "cli": "opencode", "provider": "openrouter", "model": "anthropic/claude-sonnet-4.6" },
    { "cli": "crush", "provider": "openrouter", "model": "qwen/qwen3-coder-plus" },
    { "cli": "crush", "provider": "openrouter", "model": "deepseek/deepseek-v4-pro-0813" },
    { "cli": "crush", "provider": "openrouter", "model": "z-ai/glm-5.3" },
    { "cli": "crush", "provider": "openrouter", "model": "moonshotai/kimi-k3" },
    { "cli": "crush", "provider": "openrouter", "model": "openai/gpt-5.6-sol" },
    { "cli": "crush", "provider": "openrouter", "model": "anthropic/claude-sonnet-4.6" },
    { "cli": "kilo", "provider": "openrouter", "model": "qwen/qwen3-coder-plus" },
    { "cli": "kilo", "provider": "openrouter", "model": "deepseek/deepseek-v4-pro-0813" },
    { "cli": "kilo", "provider": "openrouter", "model": "z-ai/glm-5.3" },
    { "cli": "kilo", "provider": "openrouter", "model": "moonshotai/kimi-k3" },
    { "cli": "kilo", "provider": "openrouter", "model": "openai/gpt-5.6-sol" },
    { "cli": "kilo", "provider": "openrouter", "model": "anthropic/claude-sonnet-4.6" }
  ]
}
